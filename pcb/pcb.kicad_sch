	)
	(text "designing for output = 12.6V, 2A:\ninductor ripple current (using 20%) = 0.84A\nat 150kHz, L = 25.3uH (pick 33uH)\nat input = 5V (min), output = 13V (12.6 + diode): duty cycle ~= 0.7\nripple current ~= 0.71A\npeak inductor current ~= 7A\n2x 220uF, 35mOhm(@100kHz) polymer caps yields ~150mV ripple\nRC filter cell voltage sensing\n\n5nC gate charge at ~1A: 5ns\n@2A, 150kHz: switching losses ~= 30mW, conduction losses ~= 0.7W\nswitching frequency can likely be pushed a decent amount higher as well"
		(exclude_from_sim no)
		(at 14.732 160.528 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "39758054-54a7-4a2a-831a-bf35b2acce95")
	)
	(text "NOTE:\nthis document is quite verbose for sake of documentation\nall capacitors are X7R unless otherwise specified"
		(exclude_from_sim no)
		(at 14.732 21.844 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "48690a6d-b21a-4a60-a9f9-8f1a35feb5e3")
	)
