	)
	(text "NOTE: no rpol prot for simplicity\nthis is an internal interface anyways"
		(exclude_from_sim no)
		(at 55.88 218.186 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "742e2ac2-b998-4356-bdb7-734410fbd7fc")
	)
	(text "at ~8.6 ENOB, oversampling to 1kHz (4 channels, 125kHz each), yields ~12ENOB\nwhich yields ~4mV noise floor, which should be good enough\nof course should oversample a lot more\n(cell balancing is slow, can filter to ~1Hz response or even less)\n(correcting balancing on the scale of around 10mV at minimum)\nthus using same resistors for divider\n~700Hz low-pass filter against boost converter ripple"
		(exclude_from_sim no)
		(at 85.09 188.214 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "82196d4c-8788-4e4d-8335-41bb9d2fb82c")
	)
	(text "~0.75W @2A"
		(exclude_from_sim no)
		(at 164.592 157.734 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "82d75ecd-9310-45bd-a4b3-546022709df3")
	)
	(text "100kHz LPF"
		(exclude_from_sim no)
		(at 61.468 81.788 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "8713f567-3c8c-4000-b5e2-7173858315d7")
	)
	(text "250mW, use 1W for\nless thermal drift"
		(exclude_from_sim no)
		(at 53.594 101.346 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
