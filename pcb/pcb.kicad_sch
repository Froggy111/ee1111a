	)
	(text "used for burning away cells selectively to balance\nbalancing is handled in software by measuring cell voltages\nburning is slow (~20mA), but should be fast enough\nto balance initially and then maintain said balance\ncharging is simply done by supplying to VCC\nusing very overkill mosfet driver here to reduce component count"
		(exclude_from_sim no)
		(at 191.77 225.044 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f60a8daa-5010-4d41-b53e-4bb3eedb6477")
	)
