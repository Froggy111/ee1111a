	)
	(text "at ~8.6 ENOB, oversampling to 1kHz (4 channels, 125kHz each), yields ~12ENOB\nwhich yields ~4mV noise floor, which should be good enough\nof course should oversample a lot more\n(cell balancing is slow, can filter to ~1Hz response or even less)\n(correcting balancing on the scale of around 10mV at minimum)\nthus using same resistors for divider\n~700Hz low-pass filter against boost converter ripple"
		(exclude_from_sim no)
		(at 85.09 188.214 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "82196d4c-8788-4e4d-8335-41bb9d2fb82c")
	)
